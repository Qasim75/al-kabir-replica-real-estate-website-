PORT=5000
MONGO_URI=mongodb://localhost:27017/alkabir_db
NODE_ENV=development

# Comma-separated list of allowed frontend origins in production, e.g. https://alkabirdeveloper.com
CORS_ORIGIN=*

# Optional: lets scripted/API clients read data with an x-api-key header instead of a JWT login
# Generate a strong random value for production, e.g.: openssl rand -hex 32
ADMIN_API_KEY=your_secret_key_here

# Admin dashboard authentication (required)
# Generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Used only by `node seed/createAdmin.js` to create the first admin login
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=changeme123
